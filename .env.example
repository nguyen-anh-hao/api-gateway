# api-gateway local defaults (match trading-infra-deploy)
API_GATEWAY_PORT=8080
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
ORDER_SERVICE_ADDR=localhost:8087
MARKET_DATA_ADDR=localhost:8085
