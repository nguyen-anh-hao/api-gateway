# GATEWAY_API_KEYS={"bot-key":{"account_id":1001,"secret":"bot-secret","permissions":["read_only","trade"]}}
GATEWAY_API_KEYS=
OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=
